{
  "name": "bottlepos_automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "playwright:install": "npm install && npx playwright install && pip install trcli",
    "playwright:init": "npx playwright test tests/ --config playwright.config.ts --grep @init --grep-invert @profiles",
    "playwright:smoke-parallel": "npx playwright test tests/ --config playwright.parallel.config.ts --grep @smoke --grep-invert \"@init|@nonparallelizable|@noID\"",
    "playwright:smoke-nonparallel": "npx playwright test tests/ --config playwright.nonparallel.config.ts --grep \"(?=.*@smoke)(?=.*@nonparallelizable)\" --grep-invert \"@init|@noID\"",
    "playwright:smoke": "npm run playwright:smoke-parallel ; npm run playwright:smoke-nonparallel",
    "playwright:regression-parallel": "npx playwright test tests/ --config playwright.parallel.config.ts --grep @regression --grep-invert \"@init|@nonparallelizable|@noID\"",
    "playwright:regression-nonparallel": "npx playwright test tests/ --config playwright.nonparallel.config.ts --grep \"(?=.*@regression)(?=.*@nonparallelizable)\" --grep-invert \"@init|@noID\"",
    "playwright:regression": "npm run playwright:regression-parallel ; npm run playwright:regression-nonparallel",
    "playwright:debug": "npx playwright test tests/ --config playwright.config.ts --grep @debug --debug",
    "playwright:run-single": "npx playwright test tests/ --config playwright.config.ts --grep @run-single --headed",
    "playwright:parallel": "mkdir test-results\\parallel 2>nul && npx playwright test tests/ --config playwright.parallel.config.ts --grep-invert \"@init|@nonparallelizable|@noID\"",
    "playwright:parallel:heal": "mkdir test-results\\parallel 2>nul && npm run agent:run",
    "playwright:nonparallel": "mkdir test-results\\nonparallel 2>nul && npx playwright test tests/ --config playwright.nonparallel.config.ts --grep \"(?=.*@nonparallelizable)\" --grep-invert \"@init|@noID\"",
    "playwright:run-hybrid": "npm run playwright:parallel & npm run playwright:nonparallel",
    "playwright:run": "npm run playwright:run-hybrid",
    "playwright:consolidate-reports": "node scripts/consolidate-reports.js",
    "playwright:show-report": "npm run playwright:consolidate-reports && open test-results/test-summary.html",
    "playwright:upload-testrail": "npm run playwright:consolidate-reports && node reporting.js",
    "playwright:run-and-upload": "npm run playwright:run && npm run playwright:upload-testrail",

     "agent:generate": "ts-node agent/commands/generate.ts",
     "agent:heal": "ts-node agent/commands/heal.ts",
     "agent:full": "ts-node agent/agent.ts",
     "agent:run": "npx ts-node ./agent/commands/run.ts",
     "agent:test": "npm run agent:run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@playwright/test": "^1.45.1",
    "@types/node": "^20.11.30"
  },
  "dependencies": {
    "@types/moment": "^2.13.0",
    "axios": "^1.7.2",
    "chromadb": "^3.3.1",
    "dotenv": "^17.3.1",
    "moment": "^2.30.1",
    "openai": "^6.25.0",
    "playwright": "^1.52.0",
    "ts-node": "^10.9.2",
    "uuid": "^13.0.0"
  }
}
